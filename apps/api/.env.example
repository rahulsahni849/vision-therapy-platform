# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vision_therapy?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION_DAYS="30"

# Server
PORT=3000
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:5173"

# Email (Mailgun - free 1,000 emails/month)
# Options: mailgun, brevo, resend, console
EMAIL_PROVIDER="console"
MAILGUN_API_KEY="your_mailgun_api_key_here"
MAILGUN_DOMAIN="your_domain.mailgun.org"
EMAIL_FROM="noreply@your_domain.mailgun.org"
